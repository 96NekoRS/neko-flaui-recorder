<Window x:Class="FlaUI_Test_Recorder.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose running process"
        Height="520"
        Width="760"
        MinHeight="420"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#151A24"
        Foreground="#E6ECFA">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#20293A" />
            <Setter Property="Foreground" Value="#E6ECFA" />
            <Setter Property="BorderBrush" Value="#34435E" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#20293A" />
            <Setter Property="Foreground" Value="#E6ECFA" />
            <Setter Property="BorderBrush" Value="#34435E" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3550" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5B8CFF" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10">
            <TextBlock Text="Select a running process to attach"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
        </StackPanel>
        
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="Search:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Foreground="#AFC0E8" />
            <TextBox x:Name="SearchTextBox"
                     Width="260"
                     Height="32"
                     Padding="10,6"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     Background="#20293A"
                     Foreground="#E6ECFA"
                     BorderBrush="#5B8CFF"
                     BorderThickness="1"
                     CaretBrush="#E6ECFA"
                     TextChanged="SearchTextBox_TextChanged" />
        </StackPanel>

        <DataGrid x:Name="ProcessesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeight="34"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2F3A52"
                  VerticalGridLinesBrush="#2F3A52"
                  ColumnHeaderHeight="36"
                  Background="#20293A"
                  BorderBrush="#34435E"
                  BorderThickness="1"
                  Foreground="#E6ECFA"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  MouseDoubleClick="ProcessesDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="2*" />
                <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="*" />
                <DataGridTextColumn Header="Main window title" Binding="{Binding MainWindowTitle}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="RefreshButton_Click" />
            <Button x:Name="SelectButton"
                    Content="Select"
                    Width="90"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="SelectButton_Click" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="90"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
