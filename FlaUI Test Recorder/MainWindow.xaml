<Window x:Class="FlaUI_Test_Recorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlaUI_Test_Recorder"
        mc:Ignorable="d"
        Title="FlaUI Test Recorder"
        Height="1200"
        Width="1800"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#151A24"
        Foreground="#E6ECFA">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#151A24" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1E2432" />
        <SolidColorBrush x:Key="BorderBrushModern" Color="#2D3649" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#79A0FF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E0565B" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6ECFA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA9C3" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushModern}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252E40" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#34435E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A3650" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#3A4A69" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#88AFFF" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#F07D81" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelBorderStyle}"
                Padding="20"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="FlaUI Recorder"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Capture interactions in another WPF app and generate FlaUI test code."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#25304A"
                        BorderBrush="#3E5277"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="{Binding StatusText}"
                               Foreground="#BFD2FF"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource PanelBorderStyle}"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Target executable path"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox x:Name="TargetPathTextBox"
                             Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="620"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="BrowseButton"
                            Content="Browse"
                            Margin="10,0,0,0"
                            Command="{Binding BrowseCommand}" />
                    <Button x:Name="LaunchButton"
                            Content="Launch Target"
                            Margin="10,0,0,0"
                            Command="{Binding LaunchCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0">
                    <TextBlock Text="or attach by PID"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,10,0" />
                    <TextBox x:Name="TargetProcessIdTextBox"
                             Text="{Binding TargetProcessIdInput, UpdateSourceTrigger=PropertyChanged}"
                             Width="150"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="ChooseProcessButton"
                            Content="Choose"
                            Margin="10,0,0,0"
                            Command="{Binding SelectRunningProcessCommand}" />
                    <Button x:Name="AttachButton"
                            Content="Attach"
                            Margin="10,0,0,0"
                            Command="{Binding AttachCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Grid.RowSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <Button x:Name="StartRecordingButton"
                            Content="Start Recording"
                            Width="140"
                            Margin="0,0,10,0"
                            Command="{Binding StartRecordingCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="StopRecordingButton"
                            Content="Stop"
                            Width="90"
                            Margin="0,0,10,0"
                            Command="{Binding StopRecordingCommand}"
                            Style="{StaticResource DangerButtonStyle}" />
                    <Button x:Name="ClearButton"
                            Content="Clear"
                            Width="90"
                            Command="{Binding ClearCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Recorded events"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <ListView x:Name="EventsListView"
                              ItemsSource="{Binding RecordedInteractions}"
                              Grid.Row="1"
                              Margin="0,12,0,0"
                              Background="#20293A"
                              BorderBrush="#34435E"
                              BorderThickness="1"
                              Foreground="{StaticResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="42" DisplayMemberBinding="{Binding Index}" />
                                <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding EventType}" />
                                <GridViewColumn Header="Details" Width="360" DisplayMemberBinding="{Binding Description}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Generated FlaUI test code"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBox x:Name="GeneratedCodeTextBox"
                             Text="{Binding GeneratedCode, Mode=OneWay}"
                             Grid.Row="1"
                             Margin="0,12,0,0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             Background="#0F1420"
                             BorderBrush="#34435E" />

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button x:Name="RegenerateButton"
                                Content="Regenerate"
                                Width="110"
                                Margin="0,0,10,0"
                                Command="{Binding RegenerateCommand}" />
                        <Button x:Name="CopyCodeButton"
                                Content="Copy Code"
                                Width="110"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding CopyCodeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="4,14,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Tip: Start recording, switch to your target app, perform actions, then stop and review generated code." />
    </Grid>
</Window>
